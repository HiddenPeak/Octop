#!/bin/bash
#
# inhere-box 本地版 — 安装前回调
# 预校验安装向导：用户名、密码/确认、可选邮箱。无效输入在此拦截。
#
set -euo pipefail

_INHERE_BOX_COMMON="$(dirname "$0")/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] || _INHERE_BOX_COMMON="/var/apps/inhere-box-native/cmd/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] && source "$_INHERE_BOX_COMMON"

fail_init() {
    echo "[inhere-box-native] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[inhere-box-native] $1" >&2 || true
    exit 1
}

if type inhere_box_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(inhere_box_assert_native_arch)"; then
        fail_init "$REASON"
    fi
fi

ADMIN_USER="$(inhere_box_sanitize_value "${wizard_admin_username:-}")"
ADMIN_DISPLAY="$(inhere_box_sanitize_value "${wizard_admin_display_name:-}")"
ADMIN_EMAIL="$(inhere_box_sanitize_value "${wizard_admin_email:-}")"
WIZARD_PASSWORD="$(inhere_box_sanitize_value "${wizard_admin_password:-}")"
WIZARD_CONFIRM="$(inhere_box_sanitize_value "${wizard_admin_password_confirm:-}")"

if ! REASON="$(inhere_box_validate_install_fields "$ADMIN_USER" "$WIZARD_PASSWORD" "$WIZARD_CONFIRM" "$ADMIN_EMAIL" "$ADMIN_DISPLAY" 2>&1)"; then
    fail_init "$REASON"
fi

exit 0
