#!/bin/bash
#
# inhere-box — 配置变更前回调
# 设置窗口只改管理员密码：两栏都空=保持不变；填了则校验一致与密码策略。
#
set -euo pipefail

_INHERE_BOX_COMMON="$(dirname "$0")/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] || _INHERE_BOX_COMMON="/var/apps/inhere-box/cmd/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] && source "$_INHERE_BOX_COMMON"

fail_config() {
    echo "[inhere-box] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[inhere-box] $1" >&2 || true
    exit 1
}

WIZARD_PASSWORD="$(inhere_box_sanitize_value "${wizard_admin_password:-}")"
WIZARD_CONFIRM="$(inhere_box_sanitize_value "${wizard_admin_password_confirm:-}")"

if ! REASON="$(inhere_box_validate_optional_password_change "$WIZARD_PASSWORD" "$WIZARD_CONFIRM" 2>&1)"; then
    fail_config "$REASON"
fi

exit 0
