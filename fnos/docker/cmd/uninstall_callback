#!/bin/bash
# inhere-box — 卸载后回调
# 根据卸载向导选择：完全删除时清理 data-share 用户数据；保留数据时不作处理。
set -euo pipefail

_INHERE_BOX_COMMON="$(dirname "$0")/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] || _INHERE_BOX_COMMON="/var/apps/inhere-box/cmd/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] && source "$_INHERE_BOX_COMMON"

if [ "${wizard_delete_data:-no}" = "yes" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS:-}"
    DATA_DIR="${DATA_DIR%%:*}"
    if [ -z "$DATA_DIR" ] && type inhere_box_data_share_dir >/dev/null 2>&1; then
        DATA_DIR="$(inhere_box_data_share_dir inhere-box/data)"
    fi
    if [ -n "$DATA_DIR" ] && [ -d "$DATA_DIR" ]; then
        rm -rf "$DATA_DIR" 2>/dev/null || true
        echo "[inhere-box] 已删除用户数据: $DATA_DIR" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
    fi
    LEGACY=""
    if type inhere_box_legacy_docker_data_dir >/dev/null 2>&1; then
        LEGACY="$(inhere_box_legacy_docker_data_dir)"
    fi
    if [ -n "$LEGACY" ] && [ -d "$LEGACY" ] && [ "$LEGACY" != "$DATA_DIR" ]; then
        rm -rf "$LEGACY" 2>/dev/null || true
    fi
fi

exit 0
