#!/bin/bash
#
# inhere-box — 安装后回调
#
# 安装向导只收集用户自己设的管理员账号（用户名 / 密码确认，显示名与邮箱可选）。
# 凭据写入 .env、data-share 引导文件与 inhere-box-login.txt，供容器首次 init / 改密。
#
set -euo pipefail

# 共享函数库（find_python312 / fix_ownership_and_perms / free_inhere_box_ports /
# inhere_box_generate_password / inhere_box_validate_password / inhere_box_write_login_file /
# inhere_box_render_config_wizard 等）
# 打包时由 scripts/build-fpk.sh 注入；仓库内运行无此文件时跳过（函数缺失时再报错）。
_INHERE_BOX_COMMON="$(dirname "$0")/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] || _INHERE_BOX_COMMON="/var/apps/inhere-box/cmd/common.sh"
[ -f "$_INHERE_BOX_COMMON" ] && source "$_INHERE_BOX_COMMON"

# 释放 inhere-box 端口（8088=Docker 版，8089=本地版），杀掉残留/孤儿进程，避免重装端口冲突。
free_inhere_box_ports

ENV_FILE="${TRIM_APPDEST:-/var/apps/inhere-box/target}/docker/.env"
mkdir -p "$(dirname "$ENV_FILE")"

# 挂飞牛 data-share（TRIM_DATA_SHARE_PATHS），升级/重启都保留；旧 share/ 路径会迁过来。
DATA_DIR="$(inhere_box_prepare_docker_persist "$ENV_FILE")"
mkdir -p "$DATA_DIR"

fail_install() {
    echo "[inhere-box] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>&1 || true
    echo "[inhere-box] $1" >&2 || true
    exit 1
}

# ---------------------------------------------------------------------------
# 解析向导字段（wizard/install 的 field 名即环境变量名）
# ---------------------------------------------------------------------------
ADMIN_USER="$(inhere_box_sanitize_value "${wizard_admin_username:-}")"
ADMIN_DISPLAY="$(inhere_box_sanitize_value "${wizard_admin_display_name:-}")"
ADMIN_EMAIL="$(inhere_box_sanitize_value "${wizard_admin_email:-}")"
WIZARD_PASSWORD="$(inhere_box_sanitize_value "${wizard_admin_password:-}")"
WIZARD_CONFIRM="$(inhere_box_sanitize_value "${wizard_admin_password_confirm:-}")"

if ! ADMIN_PASS_REASON="$(inhere_box_validate_install_fields "$ADMIN_USER" "$WIZARD_PASSWORD" "$WIZARD_CONFIRM" "$ADMIN_EMAIL" "$ADMIN_DISPLAY" 2>&1)"; then
    fail_install "$ADMIN_PASS_REASON"
fi
ADMIN_PASS="$WIZARD_PASSWORD"

{
    echo "INHERE_BOX_PORT=8088"
    echo "INHERE_BOX_BIND_HOST=0.0.0.0"
    echo "INHERE_BOX_LOG_LEVEL=info"
    echo "INHERE_BOX_ADMIN_USERNAME=${ADMIN_USER}"
    echo "INHERE_BOX_DEFAULT_PASSWORD=${ADMIN_PASS}"
    echo "INHERE_BOX_ADMIN_DISPLAY_NAME=${ADMIN_DISPLAY}"
    echo "INHERE_BOX_ADMIN_EMAIL=${ADMIN_EMAIL}"
    echo "TRIM_DATA_SHARE_PATHS=${DATA_DIR}"
    echo "INHERE_BOX_DATA=${DATA_DIR}"
} > "$ENV_FILE"

chmod 600 "$ENV_FILE"
inhere_box_persist_docker_env "$ENV_FILE"
inhere_box_write_fnos_bootstrap "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$ADMIN_DISPLAY" "$ADMIN_EMAIL"
inhere_box_distribute_docker_env "$ENV_FILE" "$DATA_DIR"
if [ -f "${DATA_DIR}/.inhere-box/inhere-box.db" ] || [ -d "${DATA_DIR}/.octop" ]; then
    inhere_box_mark_fnos_passwd_pending "$DATA_DIR"
fi
echo "[inhere-box] 已写入配置: $ENV_FILE（data-share=${DATA_DIR}）" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 凭据应急备份（inhere-box-login.txt）+ 渲染「设置」窗口用户名
# ---------------------------------------------------------------------------
inhere_box_write_login_file "$DATA_DIR" "$ADMIN_USER" "$ADMIN_PASS" 8088

WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/inhere-box/target}/wizard/config.template"
WIZARD_DIR="$(dirname "${TRIM_APPDEST:-/var/apps/inhere-box/target}")/wizard"
[ -f "$WIZARD_TEMPLATE" ] || WIZARD_TEMPLATE="${TRIM_APPDEST:-/var/apps/inhere-box/target}/../wizard/config"
inhere_box_render_config_wizard "$WIZARD_TEMPLATE" "$WIZARD_DIR" "$ADMIN_USER" "$ADMIN_PASS" "$DATA_DIR"

exit 0
